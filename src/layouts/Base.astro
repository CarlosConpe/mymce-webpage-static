---
import '../styles/sitio.css';
import '../styles/propio.css';
import '../styles/correcciones.css';
import '../styles/picture.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { D, WA, TEL, LEAD, CONVERSION, MAPA_EMBED, CREDITO, grafo, ruta as migas } from '../data/sitio';
import fechas from '../data/fechas.json';
import og from '../data/og.json';

interface Props {
  title: string;
  desc: string;
  ruta: string;
  img?: string;
  lang?: string;
  noindex?: boolean;
  alternos?: string[][];
  wa?: string | null;
  waEtiqueta?: string | null;
  ld?: object[];
  migasLd?: [string, string | null][];
  carrusel?: boolean;
  videoFix?: boolean;
  clasica?: boolean;
  preload?: string;
  preloadMovil?: string;
  videos?: string[];
  cotizar?: boolean;
}
const { title, desc, ruta, img = '/assets/storage/2016/12/logo-mymce-carpinteria.webp', lang = 'es-MX', noindex = false, alternos = [], wa, waEtiqueta, ld = [], migasLd, carrusel = false, videoFix = false, clasica = false, preload, preloadMovil, videos = [], cotizar = false } = Astro.props;
const url = D + ruta;
const ingles = lang.startsWith('en');
// Solo el par español-inglés de puertas tiene versiones en otro idioma.
const idiomas = alternos.some(([h]) => h.startsWith('en')) ? alternos : [];
// En las páginas en inglés, el enlace "Español" lleva a su versión en español.
const espanol = alternos.find(([h]) => h === 'es-MX')?.[1] ?? '/';
// Solo las fotos del portafolio llevan crédito de MYMCE: en otras páginas puede haber fotos de catálogo.
// Tipo de página para los datos estructurados; la fecha es la del último commit que cambió su contenido (scripts/fechas-git.mjs).
const tipo = ruta === '/corporate/contact/' ? 'ContactPage'
  : ruta.startsWith('/corporate/acerca-de-mymce') ? 'AboutPage'
  : ruta === '/portafolio/' || ruta === '/corporate/blog/' || /^\/servicios\/cocinas-y-closets-/.test(ruta) ? 'CollectionPage'
  : 'WebPage';
const modificada = (fechas as Record<string, string>)[ruta];
// Imagen de 1200 x 630 para compartir (scripts/og-imagenes.mjs); si la página no tiene, la de siempre.
const ogImg = (og as Record<string, string>)[ruta];
const imagen = { '@type': 'ImageObject', '@id': `${url}#imagen-principal`, url: D + img, contentUrl: D + img, ...(ruta.startsWith('/portafolio/') && CREDITO) };
const datos = grafo(
  { '@type': tipo, '@id': `${url}#pagina`, url, name: title, description: desc, inLanguage: lang, isPartOf: { '@id': `${D}/#sitio` }, about: { '@id': `${D}/#localbusiness` }, primaryImageOfPage: { '@id': imagen['@id'] }, ...(migasLd && { breadcrumb: { '@id': `${url}#ruta` } }), ...(modificada && { dateModified: modificada }), ...(videos.length && { video: videos.map((v) => ({ '@id': v })) }) },
  imagen,
  { '@type': 'WebSite', '@id': `${D}/#sitio`, url: `${D}/`, name: 'MYMCE', inLanguage: ['es-MX', 'en'], publisher: { '@id': `${D}/#localbusiness` } },
  ...(migasLd ? [migas(migasLd, ruta)] : []),
  ...ld,
);
---
<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={desc}>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}>
    {!noindex && <link rel="canonical" href={url}>}
    {idiomas.map(([h, u]) => <link rel="alternate" hreflang={h} href={D + u}>)}
    <link rel="icon" href="/assets/storage/2016/12/favicon-1.webp">
    <meta name="theme-color" content="#475a66">
    <meta property="og:locale" content={ingles ? 'en_US' : 'es_MX'}>
    <meta property="og:type" content={/^\/corporate\/blog\/\d{4}\//.test(ruta) ? 'article' : 'website'}>
    <meta property="og:site_name" content="MYMCE">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={desc}>
    <meta property="og:url" content={url}>
    <meta property="og:image" content={D + (ogImg ?? img)}>
    {ogImg && <meta property="og:image:width" content="1200">}
    {ogImg && <meta property="og:image:height" content="630">}
    <meta property="og:image:alt" content={title.split('|')[0].trim()}>
    <meta name="twitter:card" content="summary_large_image">
    {preload && !preloadMovil && <link rel="preload" as="image" href={preload} fetchpriority="high">}
    {preloadMovil && <link rel="preload" as="image" href={preload} fetchpriority="high" media="(min-width: 481px)">}
    {preloadMovil && <link rel="preload" as="image" href={preloadMovil} fetchpriority="high" media="(max-width: 480px)">}
    <link rel="preload" href="/assets/fonts/source-sans-pro-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/fontawesome-webfont.woff2" as="font" type="font/woff2" crossorigin>
    <script type="application/ld+json" set:html={JSON.stringify(datos).replace(/</g, '\u003c')}></script>
    <script is:inline src="/assets/js/medicion.js?v=4" defer></script>
</head>
<body class:list={[{ 'con-carrusel': carrusel, 'con-video': videoFix, 'pagina-clasica': clasica }]} data-conversion={CONVERSION[ruta] ?? LEAD} data-lead={LEAD}>
<a class="salto" href="#contenido">{ingles ? 'Skip to content' : 'Saltar al contenido'}</a>
<div>
    <Cabecera ingles={ingles} espanol={espanol} />
    <main id="contenido"><slot /></main>
</div>
{ruta === '/' && <div class="section-item section-empty no-paddings no-paddings-y no-margins">
    <div class="content"><div class="row"><div class="col-md-12">
        <div class="mapa-diferido" data-src={MAPA_EMBED}><p>Cargando mapa...</p></div>
    </div></div></div>
</div>}
<button type="button" class="scroll-top scroll-top-mobile fa fa-sort-asc" aria-label={ingles ? 'Back to top' : 'Volver arriba'}></button>
<Pie ingles={ingles} />
{/* Celular: barra fija con Cotizar, Llamar y WhatsApp (specs/formularios-que-venden.md). Cotizar baja al formulario de la página o va a contacto. */}
<nav class="barra-movil" aria-label={ingles ? 'Quick contact' : 'Contacto rápido'}>
    <a href={cotizar ? '#cotizar' : '/corporate/contact/#cotizar'} data-barra="cotizar"><i class="fa fa-edit"></i>{ingles ? 'Quote' : 'Cotizar'}</a>
    <a href={TEL.href} data-barra="llamar"><i class="fa fa-phone"></i>{ingles ? 'Call' : 'Llamar'}</a>
    <a href={wa ?? WA.href} target="_blank" rel="noopener" data-whatsapp="barra-movil"><i class="fa fa-whatsapp"></i>WhatsApp</a>
</nav>
<a href={wa ?? WA.href} class="wa-float" target="_blank" rel="noopener" data-whatsapp={waEtiqueta ?? 'default'} aria-label={ingles ? 'Message us on WhatsApp' : 'Escríbenos por WhatsApp'}><i class="fa fa-whatsapp"></i></a>
<script>
    import '../scripts/sitio.js';
</script>
</body>
</html>
