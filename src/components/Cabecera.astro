---
import { TEL, CORREO, DIRECCION, HORARIO_CORTO, REDES } from '../data/sitio';

// Menú para familias: servicios, fraccionamientos por zona y portafolio (con "Encuentra tu casa").
// Las 83 obras ya no van en el menú: cada una está enlazada desde su fraccionamiento y desde el portafolio.
// Las páginas para empresas siguen en el sitio, agrupadas en "Empresas".
const SERVICIOS = [
  ['/servicios/cocinas/', 'Cocinas integrales'],
  ['/servicios/cocinas-integrales-modernas/', 'Estilos de cocina moderna'],
  ['/servicios/closets-vestidores/', 'Closets'],
  ['/servicios/vestidores/', 'Vestidores'],
  ['/servicios/closets-de-melamina/', 'Closets de melamina'],
  ['/servicios/diseno-y-fabricacion-de-puertas/', 'Puertas'],
  ['/servicios/diseno-y-fabricacion-de-muebles-de-bano/', 'Muebles de baño'],
  ['/servicios/diseno-y-fabricacion-de-escritorios/', 'Escritorios'],
  ['/servicios/muebles-a-medida/', 'Muebles a la medida'],
  ['/soluciones/carpinteria-para-particulares/', 'Carpintería para tu casa'],
  ['/equipamiento/', 'Electrodomésticos'],
];
const ZONAS: [string, string, [string, string][]][] = [
  ['/servicios/cocinas-y-closets-villa-de-pozos/', 'Villa de Pozos', [['/servicios/cocinas-y-closets-catara/', 'Catara'], ['/servicios/cocinas-y-closets-sirenia/', 'Sirenia']]],
  ['/servicios/cocinas-y-closets-soledad-de-graciano-sanchez/', 'Soledad de Graciano Sánchez', [['/servicios/cocinas-y-closets-valle-real/', 'Valle Real']]],
  ['/servicios/cocinas-y-closets-imperia/', 'San Luis Potosí: Imperia', []],
];
const EMPRESAS = [
  ['/soluciones/carpinteria-para-constructoras/', 'Constructoras'],
  ['/soluciones/carpinteria-para-arquitectos/', 'Arquitectos'],
  ['/soluciones/carpinteria-para-cocinistas/', 'Cocinistas'],
  ['/servicios/maquila-de-partes/', 'Maquila de partes'],
  ['/servicios/puertas-y-piezas-recubiertas-con-foil-pvc/', 'Puertas y piezas con foil PVC'],
  ['/servicios/puertas-frentes-de-cajon-en-mdf-forrados-con-foil-pvc/', 'Frentes de cajón con foil PVC'],
  ['/servicios/pvc-foil-covered-cabinet-doors-drawer-fronts/', 'PVC foil cabinet doors (English)', 'en'],
];
---
<header class="scroll-change fixed-top">
    <div class="navbar navbar-default mega-menu-fullwidth navbar-fixed-top" role="navigation">
        <div class="navbar-mini scroll-hide">
            <div class="container">
                <nav class="marcas" aria-label="Marcas de Grupo MYMCE"><a class="marcas__marca" href="/" aria-current="page"><img src="/assets/storage/logos/mymce-marca.webp" alt="MYMCE" width="567" height="160"></a><a class="marcas__marca" href="https://grupomymce.com/" title="CPC: maquila de piezas y muebles sobre diseño para empresas"><img src="/assets/storage/logos/cpc-marca.webp" alt="CPC" width="319" height="160"></a></nav>
                <div class="nav navbar-nav navbar-left">
                    <span><a href={TEL.href}><i class="fa fa-phone"></i> {TEL.guiones}</a></span><hr>
                    <span><a href={`mailto:${CORREO}`}>{CORREO}</a></span><hr>
                    <span><a href="/corporate/contact/"><i class="fa fa-map-marker"></i> {DIRECCION.calle}, {DIRECCION.ciudad}, SLP.</a></span><hr class="mini-horario">
                    <span class="mini-horario"><a href="/corporate/contact/"><i class="fa fa-calendar"></i> {HORARIO_CORTO}</a></span><hr><span><a href="/en/" hreflang="en" lang="en">English</a></span>
                </div>
                <div class="nav navbar-nav navbar-right">
                    <div class="minisocial-group">
                        <a href={REDES.facebook} target="_blank" rel="noopener" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
                        <a href={REDES.instagram} target="_blank" rel="noopener" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                        <a href={REDES.youtube} target="_blank" rel="noopener" aria-label="YouTube"><i class="fa fa-youtube"></i></a>
                        <a href={REDES.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa fa-linkedin"></i></a>
                    </div>
                    <div class="navbar-left custom-area">
                        <div class="minisocial-group" id="searchx"><a href="/portafolio/" aria-label="Ver el portafolio"><i class="fa fa-search"></i></a></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="navbar navbar-main">
            <div class="container">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-principal"><i class="fa fa-bars"></i></button>
                    <a class="navbar-brand" href="/">
                        <img class="logo-default" src="/assets/storage/2016/12/logo-mymce-carpinteria.webp" srcset="/assets/storage/2016/12/logo-mymce-carpinteria-280w.webp 280w, /assets/storage/2016/12/logo-mymce-carpinteria.webp 935w" sizes="140px" alt="MYMCE, carpintería en San Luis Potosí" width="935" height="267" fetchpriority="high">
                        <img class="logo-retina" src="/assets/storage/2016/12/logo-2.webp" alt="MYMCE" width="180" height="51">
                    </a>
                </div>
                <div class="collapse navbar-collapse" id="menu-principal">
                    <ul class="nav navbar-nav" id="main-menu">
                        <li class="dropdown multi-level">
                            <a class="dropdown-toggle" href="/servicios/">Servicios <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                {SERVICIOS.map(([u, n]) => <li><a href={u}>{n}</a></li>)}
                            </ul>
                        </li>
                        <li class="dropdown multi-level">
                            <a class="dropdown-toggle" href="/servicios/cocinas-y-closets-villa-de-pozos/">Fraccionamientos <span class="caret"></span></a>
                            <ul class="dropdown-menu menu-zonas">
                                {ZONAS.map(([u, n, fraccs]) => (
                                    <li class="menu-zona"><a href={u}>{n}</a>
                                        {fraccs.length > 0 && <ul>{fraccs.map(([fu, fn]) => <li><a href={fu}>{fn}</a></li>)}</ul>}
                                    </li>
                                ))}
                            </ul>
                        </li>
                        <li><a href="/portafolio/">Portafolio</a></li>
                        <li class="dropdown multi-level">
                            <a class="dropdown-toggle" href="/corporate/acerca-de-mymce-carpinteria-profesional-en-san-luis-potosi/">Nosotros <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a href="/corporate/acerca-de-mymce-carpinteria-profesional-en-san-luis-potosi/">Acerca de MYMCE</a></li>
                                <li><a href="/corporate/garantia/">Garantía</a></li>
                                <li><a href="/corporate/preguntas-frecuentes/">Preguntas frecuentes</a></li>
                                <li><a href="/corporate/contact/">Contacto</a></li>
                            </ul>
                        </li>
                        <li><a href="/corporate/blog/">Blog</a></li>
                        <li class="dropdown multi-level menu-empresas">
                            <a class="dropdown-toggle" href="/soluciones/carpinteria-para-constructoras/">Empresas <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                {EMPRESAS.map(([u, n, idioma]) => <li><a href={u} hreflang={idioma}>{n}</a></li>)}
                            </ul>
                        </li>
                    </ul>
                    <div class="nav navbar-nav navbar-right">
                        <div class="custom-area">
                            <div class="button-cnt"><a class="btn btn-lg" href="/corporate/contact/">Contáctanos</a></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
