---
// Todas las páginas comparten cabecera y pie; el contenido de cada una vive en src/contenido.
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import paginas from '../data/paginas.json';
import { D, preguntasLd, videosLd } from '../data/sitio';
import { conVariantes } from '../data/imagenes';
import { conIconos } from '../data/iconos';

const contenido = import.meta.glob('../contenido/**/index.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const NOMBRES: Record<string, string> = { corporate: 'Nosotros', servicios: 'Servicios', soluciones: 'Carpintería', portafolio: 'Portafolio', blog: 'Blog' };

export function getStaticPaths() {
  return paginas.filter((p) => p.ruta !== '/404/' && p.ruta !== '/').map((p) => ({ params: { ruta: p.ruta.slice(1, -1) }, props: { p } }));
}
const { p } = Astro.props as { p: (typeof paginas)[number] };
const html = contenido[`../contenido/${p.archivo}`];

// Migas para los datos estructurados: cada tramo de la ruta que exista como página.
const existe = new Set(paginas.map((x) => x.ruta));
const tramos = p.ruta.split('/').filter(Boolean);
const migas: [string, string | null][] = [[p.lang === 'en' ? 'Home' : 'Inicio', p.lang === 'en' ? '/en/' : '/']];
tramos.forEach((_, i) => {
  const u = '/' + tramos.slice(0, i + 1).join('/') + '/';
  if (u === p.ruta) migas.push([p.title.split('|')[0].trim(), null]);
  else if (existe.has(u)) migas.push([NOMBRES[tramos[i]] ?? tramos[i], u]);
});

// La foto grande de arriba es lo primero que se ve: se pide desde el encabezado para que no llegue tarde.
const PORTADA_PORTAFOLIO = '/assets/storage/2023/08/cocina-17-5-1920x1080.webp';
const preload = p.ruta === '/portafolio/' ? PORTADA_PORTAFOLIO : html.match(/class="header-title[^"]*"[^>]*background-image:url\(([^)]+)\)/)?.[1];
// En celular se usa la versión recortada y ligera que crea scripts/portadas-movil.py, si existe.
const movil = preload?.replace(/\.webp$/, '-movil.webp');
const preloadMovil = movil && existsSync(`${process.cwd()}/public${movil}`) ? movil : undefined;

// Las preguntas visibles se publican también como datos estructurados: el acordeón de la página de preguntas
// frecuentes y, en las demás, cada pregunta en un h3 seguido de su respuesta (si hay al menos dos).
const ld: object[] = [];
const limpio = (t: string) => t.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').replace(/\s+([.,;:])/g, '$1').trim();
const faq = (p.ruta === '/corporate/preguntas-frecuentes/'
  ? [...html.matchAll(/<div class="list-group-item[^"]*">\s*<a[^>]*>([\s\S]*?)<\/a>\s*<div class="panel[^"]*">\s*<div class="inner">([\s\S]*?)<\/div>/g)].map((m) => [m[1], m[2]])
  : [...html.matchAll(/<h3>\s*([^<]+\?)\s*<\/h3>\s*(?:<p>([\s\S]*?)<\/p>|<div>([\s\S]*?)<\/div>)/g)].map((m) => [m[1], m[2] ?? m[3]])
).map((par) => par.map(limpio) as [string, string]).filter(([, r]) => r);
if (faq.length >= (p.ruta === '/corporate/preguntas-frecuentes/' ? 1 : 2)) ld.push(preguntasLd(p.ruta, faq));
// Los artículos del blog llevan su fecha (sale de la ruta); el mapa del sitio la usa como lastmod.
const fecha = p.ruta.match(/^\/corporate\/blog\/(\d{4})\/(\d{2})\/(\d{2})\//)?.slice(1).join('-');
const negocio = { '@id': `${D}/#localbusiness` };
// Artículos reescritos después de publicarse: fecha de la última revisión.
const REVISADO: Record<string, string> = {
  '/corporate/blog/2023/07/04/tendencias-de-color-refleja-tu-personalidad/': '2026-11-08',
  '/corporate/blog/2023/07/17/consejos-de-organizacion-para-un-closet/': '2026-11-08',
  '/corporate/blog/2023/07/17/tendencias-de-color/': '2026-11-08',
  '/corporate/blog/2023/07/17/tendencias-modernas-en-cocinas-integrales/': '2026-11-08',
};
if (fecha) ld.push({ '@type': 'BlogPosting', '@id': `${D}${p.ruta}#articulo`, headline: p.title.split('|')[0].trim(), description: p.desc, datePublished: fecha, dateModified: REVISADO[p.ruta] ?? fecha, author: negocio, publisher: negocio, image: D + (p.img || '/assets/storage/2016/12/169471652699961817.webp'), mainEntityOfPage: `${D}${p.ruta}`, inLanguage: 'es-MX' });
// Las páginas de servicios describen el servicio que se ofrece y en qué zonas.
const h1 = html.match(/<h1[^>]*>([\s\S]*?)<\/h1>/)?.[1].replace(/<[^>]+>/g, '').trim();
ld.push(...videosLd(html, p.ruta, p.title.split('|')[0].trim(), p.desc));
// Las páginas de fraccionamiento y de municipio dicen exactamente dónde se da el servicio; las demás, toda la zona.
const ciudad = (name: string) => ({ '@type': 'City', name, containedInPlace: { '@type': 'State', name: 'San Luis Potosí' } });
const fracc = (name: string, municipio: string) => ({ '@type': 'Place', name: `Fraccionamiento ${name}`, containedInPlace: ciudad(municipio) });
const ZONA: Record<string, object[]> = {
  '/servicios/cocinas-y-closets-catara/': [fracc('Catara', 'Villa de Pozos'), ciudad('Villa de Pozos')],
  '/servicios/cocinas-y-closets-sirenia/': [fracc('Sirenia', 'Villa de Pozos'), ciudad('Villa de Pozos')],
  '/servicios/cocinas-y-closets-valle-real/': [fracc('Valle Real', 'Soledad de Graciano Sánchez'), ciudad('Soledad de Graciano Sánchez')],
  '/servicios/cocinas-y-closets-imperia/': [fracc('Imperia', 'San Luis Potosí'), ciudad('San Luis Potosí')],
  '/servicios/cocinas-y-closets-villa-de-pozos/': [ciudad('Villa de Pozos')],
  '/servicios/cocinas-y-closets-soledad-de-graciano-sanchez/': [ciudad('Soledad de Graciano Sánchez')],
};
const zonaGeneral = [ciudad('San Luis Potosí'), ciudad('Soledad de Graciano Sánchez'), ciudad('Villa de Pozos')];
if ((p.ruta.startsWith('/servicios/') && p.ruta !== '/servicios/' || /^\/en\/.+/.test(p.ruta)) && h1) ld.push({ '@type': 'Service', '@id': `${D}${p.ruta}#servicio`, name: h1, description: p.desc, provider: negocio, areaServed: ZONA[p.ruta] ?? zonaGeneral, url: `${D}${p.ruta}` });
---
<Base title={p.title} desc={p.desc} ruta={p.ruta} img={p.img || undefined} lang={p.lang === 'en' ? 'en' : 'es-MX'} alternos={p.alternos} wa={p.wa} waEtiqueta={p.waEtiqueta} migasLd={migas} ld={ld} carrusel={p.carrusel} videoFix={p.videoFix} clasica={p.clasica} preload={preload} preloadMovil={preloadMovil}>
    <Fragment set:html={conIconos(conVariantes(html))} />
</Base>
